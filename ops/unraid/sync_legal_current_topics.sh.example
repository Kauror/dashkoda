#!/bin/bash
#
# DashKoda Koda.ee "Hetkel käsil" catalogue collection.
#
# This is step one of two. `match_legal_current_topics.sh.example` is step two
# and is scheduled separately five minutes later, so each keeps its own lock,
# its own log and its own exit code. A collection that fails therefore leaves a
# readable failure of its own rather than being buried inside a combined job.
#
# Intended for the Unraid host's own scheduler. Copy this file, set the
# deployment directory, make it executable, and schedule it. This repository
# installs nothing and enables nothing.
#
#   cp sync_legal_current_topics.sh.example \
#     /boot/config/plugins/user.scripts/sync_legal_current_topics.sh
#   chmod +x /boot/config/plugins/user.scripts/sync_legal_current_topics.sh
#
# Run it by hand once before scheduling it, and check the exit code:
#
#   DASHKODA_DEPLOYMENT_DIRECTORY=/mnt/user/appdata/dashkoda \
#     /boot/config/plugins/user.scripts/sync_legal_current_topics.sh; echo "exit=$?"
#
# Intended schedule — 07:15 every day, Europe/Tallinn:
#
#   15 7 * * *
#
# After the 07:00 workbook job and the other public feeds, because matching
# scores against whatever legal snapshot is current when it runs. Collecting
# before the workbook has been refreshed is not wrong — it simply produces an
# answer about yesterday's records — so the offset makes the ordinary case the
# useful one.
#
# Cron uses the HOST clock, so confirm the host really is on Europe/Tallinn.
# Estonia observes daylight saving, so a host left on UTC runs this an hour
# early or late depending on the season:
#
#   timedatectl                      # look for "Time zone: Europe/Tallinn"
#   date +'%Z %z %H:%M'              # expect EET +0200 in winter, EEST +0300 in summer
#
# A host that cannot express Europe/Tallinn installs this as a pair of UTC
# entries with an hour guard in the wrapper; see docs/deployment-status.md.
#
# This job takes its own PostgreSQL advisory lock, distinct from the matcher's
# and from the workbook synchronisation's, so it can neither block nor be
# blocked by them. The flock below is host-side defence in depth against two
# copies of this script overlapping.
#
# **A failure here cannot affect the legal-work data.** The workbook feed is a
# separate source with its own state row. If collection fails, the previously
# published catalogue stays exactly where it was, /oigusloome/ keeps rendering,
# and topics whose links no longer satisfy the current-snapshot rules simply
# return to plain text.
#
# Expected exit codes:
#
#   0  imported, or unchanged
#   1  collection failed; the previous catalogue is still published
#   3  the lock was already held, so a previous run is still in progress

set -euo pipefail

# Set this in the User Scripts environment, or edit the fallback below.
DEPLOYMENT_DIRECTORY="${DASHKODA_DEPLOYMENT_DIRECTORY:-<DASHKODA_DEPLOYMENT_DIRECTORY>}"

if [ ! -d "${DEPLOYMENT_DIRECTORY}" ]; then
  echo "Deployment directory not found: ${DEPLOYMENT_DIRECTORY}" >&2
  echo "Set DASHKODA_DEPLOYMENT_DIRECTORY or edit this script." >&2
  exit 1
fi

cd "${DEPLOYMENT_DIRECTORY}"

# Both Compose files are named explicitly when the deployment has a host
# override. Bare `docker compose` would recreate `web` without the host's bind
# mounts on a stack that was created from both.
COMPOSE_FILES=(-f compose.yaml)
if [ -f compose.unraid.yaml ]; then
  COMPOSE_FILES+=(-f compose.unraid.yaml)
fi

# Targets the Compose service by name rather than a generated container name,
# so a recreated container does not silently break the schedule.
#
# `--json` emits one line of aggregate counts and identifiers: never a topic, a
# candidate title, a URL or any page text. A scheduler log is not a place where
# the source's content belongs.
exec flock --nonblock /tmp/dashkoda-sync-legal-current-topics.lock \
  docker compose "${COMPOSE_FILES[@]}" exec -T web \
    python manage.py sync_legal_current_topics --json
