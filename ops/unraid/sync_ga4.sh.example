#!/bin/bash
#
# DashKoda Google Analytics website-traffic collection.
#
# ---------------------------------------------------------------------------
# THIS IS NOT INSTALLED, AND GA4 IS NOT ENABLED.
#
# The application carries a complete, tested GA4 collector. The deployment
# carries none of what it needs to run:
#
#   * no GA4_PROPERTY_ID
#   * no GA4_CREDENTIALS_FILE and no mounted service-account key
#   * no copy of this wrapper on the host
#   * no cron entry
#
# That is deliberate. Enabling GA4 is a decision, not a side effect of the code
# existing, and nothing in this repository installs or schedules anything. Do
# not copy this file to the host until enabling website traffic is actually
# intended. See docs/deployment-status.md.
# ---------------------------------------------------------------------------
#
# To enable it later:
#
#   1. create a Google Cloud service account with **viewer** access to the GA4
#      property and nothing else, and download its JSON key;
#   2. put the key somewhere the web container can read and nowhere a web
#      server serves, and mount it read-only;
#   3. set GA4_PROPERTY_ID and GA4_CREDENTIALS_FILE in the deployment's own
#      environment file — never in this repository, never on a command line;
#   4. copy this file, set the deployment directory, make it executable:
#
#        cp sync_ga4.sh.example /boot/config/plugins/user.scripts/sync_ga4.sh
#        chmod +x /boot/config/plugins/user.scripts/sync_ga4.sh
#
#   5. run it by hand once with --dry-run and check the exit code, then once
#      live, and only then schedule it:
#
#        DASHKODA_DEPLOYMENT_DIRECTORY=/mnt/user/appdata/dashkoda \
#          /boot/config/plugins/user.scripts/sync_ga4.sh; echo "exit=$?"
#
# Intended schedule — **none. This job is not scheduled and GA4 is not enabled.**
#
# When it is enabled, it must NOT go at 06:00 Tallinn. That slot is inside the
# feed chain, between the archive collection at 06:00 and its matcher at 06:15.
# An earlier version of this file suggested exactly that, from before the chain
# was compacted into 05:30–06:30.
#
# The free slots either side of the chain are before 05:30 or after 06:30.
# **05:00 Tallinn** is the recommendation: GA4 finalises a day some hours after
# it ends, this job collects the *previous* completed day, and running it ahead
# of the chain keeps the chain's own ordering untouched.
#
#   0 2 * * * /boot/config/plugins/user.scripts/sync_ga4.sh &> /dev/null
#   0 3 * * * /boot/config/plugins/user.scripts/sync_ga4.sh &> /dev/null
#
#   summer (EEST, UTC+3): the 02:00 UTC entry runs, the 03:00 one skips
#   winter (EET,  UTC+2): the 03:00 UTC entry runs, the 02:00 one skips
#
# The guard below is already set to 05 for that slot. Change both the guard and
# the pair together if you choose a different time — `docs/operations-runbook.md`
# lists what else is running.
#

# This job takes its own PostgreSQL advisory lock, distinct from every other
# feed's, so it can neither block nor be blocked by them. The flock below is
# host-side defence in depth against two copies of this script overlapping.
#
# **A failure here cannot affect anything else.** GA4 is its own source with its
# own state row. If collection fails, the previously published observation stays
# current, every other page is untouched, and the website card keeps saying what
# it said before. With GA4 unconfigured the command fails immediately, naming
# the missing variables and publishing nothing.
#
# Expected exit codes:
#
#   0  imported, unchanged, or a successful dry run
#   1  collection failed; the previous observation is still published
#   3  the lock was already held, so a previous run is still in progress

set -euo pipefail

# Europe/Athens stands in for Europe/Tallinn: identical offsets, and present in
# the trimmed zoneinfo where Tallinn is not.
TALLINN_TZ="Europe/Athens"
TARGET_HOUR="05"

if [ "${DASHKODA_FORCE:-0}" != "1" ]; then
  if [ "$(TZ="${TALLINN_TZ}" date +%H)" != "${TARGET_HOUR}" ]; then
    exit 0
  fi
fi

# Set this in the User Scripts environment, or edit the fallback below.
DEPLOYMENT_DIRECTORY="${DASHKODA_DEPLOYMENT_DIRECTORY:-<DASHKODA_DEPLOYMENT_DIRECTORY>}"

if [ ! -d "${DEPLOYMENT_DIRECTORY}" ]; then
  echo "Deployment directory not found: ${DEPLOYMENT_DIRECTORY}" >&2
  echo "Set DASHKODA_DEPLOYMENT_DIRECTORY or edit this script." >&2
  exit 1
fi

cd "${DEPLOYMENT_DIRECTORY}"

# Both Compose files are named explicitly when the deployment has a host
# override. Bare `docker compose` would recreate `web` without the host's bind
# mounts on a stack that was created from both.
COMPOSE_FILES=(-f compose.yaml)
if [ -f compose.unraid.yaml ]; then
  COMPOSE_FILES+=(-f compose.unraid.yaml)
fi

# Targets the Compose service by name rather than a generated container name,
# so a recreated container does not silently break the schedule.
#
# `--json` emits one line of aggregate counts and identifiers. It never contains
# the property ID, the credential path, an access token or any part of Google's
# response. The three figures are `null` — not `0` — on a day GA4 reported no
# rows, which is the difference between no traffic measured and zero measured.
exec flock --nonblock /tmp/dashkoda-sync-ga4.lock \
  docker compose "${COMPOSE_FILES[@]}" exec -T web \
    python manage.py sync_ga4 --json
