{
  "name": "dashkoda",
  "version": "0.1.0",
  "description": "Frontend build for the DashKoda internal management dashboard.",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build:css": "tailwindcss --input frontend/src/styles.css --output static/build/styles.css --minify",
    "build:js": "esbuild frontend/src/app.js frontend/src/charts.js --bundle --format=esm --target=es2022 --minify --outdir=static/build",
    "build": "npm run build:css && npm run build:js",
    "watch:css": "tailwindcss --input frontend/src/styles.css --output static/build/styles.css --watch",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@alpinejs/csp": "3.15.12",
    "@playwright/test": "1.62.0",
    "@tailwindcss/cli": "4.3.3",
    "echarts": "6.1.0",
    "esbuild": "0.28.1",
    "htmx.org": "2.0.10",
    "tailwindcss": "4.3.3"
  }
}
