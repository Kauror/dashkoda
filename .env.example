DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=dashkoda
POSTGRES_USER=dashkoda
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Output of `manage.py generate_viewer_pin_hash`, with **every `$` doubled**.
# Compose interpolates `$NAME` inside a `.env` value, so an unescaped PBKDF2
# hash — which always contains three of them — silently loses everything after
# the first, and the viewer PIN then fails to verify with no error to point at.
# Write `pbkdf2_sha256$$1000000$$salt$$hash`, not `pbkdf2_sha256$1000000$...`.
VIEWER_PIN_HASH=replace-with-output-from-generate-viewer-pin-hash-with-doubled-dollars
VIEWER_PIN_VERSION=1
VIEWER_RATE_LIMIT_SECRET=replace-with-a-long-random-rate-limit-secret
TRUST_CLOUDFLARE_IP_HEADER=false
DASHKODA_PORT=8000
# Where original source files are written. Production has no fallback: the
# value must point at a persistent, private directory that no web server
# serves. Compose sets the in-container path and mounts a named volume there,
# so this only needs changing for a non-Compose deployment.
SOURCE_ARTIFACT_ROOT=/srv/dashkoda/source-artifacts
# Legal-work workbook, the one recurring collection route: the view-only public
# OneDrive/SharePoint sharing URL for `dashkoda_oigusloome.xlsx`.
#
# Leave this EMPTY here. The production value belongs only in the server's own
# environment file. Treat the complete URL as a bearer-style secret: anyone who
# has it can download the workbook, so it must never be committed, pasted into
# documentation, written to a log or stored in the database.
#
# Needs no Microsoft Entra application and no client secret. Required only
# by `sync_oigusloome_public`; the web application starts fine without it.
OIGUSLOOME_PUBLIC_URL=
# Event-programme workbook: the view-only public OneDrive/SharePoint sharing URL
# for `dashkoda_events.xlsx`, the six-sheet DASH_* export.
#
# Leave this EMPTY here, exactly as above. The production value belongs only in
# the server's own environment file, and the complete URL is a bearer-style
# secret: never commit it, paste it into documentation or a chat, write it to a
# log or store it in the database.
#
# Required only by `sync_event_programme`; the web application starts fine
# without it.
EVENT_PROGRAMME_PUBLIC_URL=
# Google Analytics 4. Leave both blank here. The property ID and the mounted
# read-only service-account key belong only in the deployment environment.
GA4_PROPERTY_ID=
GA4_CREDENTIALS_FILE=
