DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=dashkoda
POSTGRES_USER=dashkoda
POSTGRES_PASSWORD=replace-with-a-local-database-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
VIEWER_PIN_HASH=replace-with-output-from-generate-viewer-pin-hash
VIEWER_PIN_VERSION=1
VIEWER_RATE_LIMIT_SECRET=replace-with-a-long-random-rate-limit-secret
TRUST_CLOUDFLARE_IP_HEADER=false
DASHKODA_PORT=8000
# Where original source files are written. Production has no fallback: the
# value must point at a persistent, private directory that no web server
# serves. Compose sets the in-container path and mounts a named volume there,
# so this only needs changing for a non-Compose deployment.
SOURCE_ARTIFACT_ROOT=/srv/dashkoda/source-artifacts
# Legal-work workbook, MVP collection route: the view-only public
# OneDrive/SharePoint sharing URL for `dashkoda_oigusloome.xlsx`.
#
# Leave this EMPTY here. The production value belongs only in the server's own
# environment file. Treat the complete URL as a bearer-style secret: anyone who
# has it can download the workbook, so it must never be committed, pasted into
# documentation, written to a log or stored in the database.
#
# Needs no Microsoft Entra application and no Graph credentials. Required only
# by `sync_oigusloome_public`; the web application starts fine without it.
OIGUSLOOME_PUBLIC_URL=
# Microsoft Graph, read-only, the optional alternative route. Not required for
# the public-link MVP. Names only — never put a real tenant, client, secret or
# identifier in this file. The web application starts fine without them; only
# `sync_oigusloome` and `resolve_oigusloome_share` require them.
#
# The Entra application needs the Files.Read.All APPLICATION permission with
# tenant admin consent. Nothing here needs write access to OneDrive.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Stable identifiers from `manage.py resolve_oigusloome_share`. The sharing URL
# itself is never configuration.
OIGUSLOOME_DRIVE_ID=
OIGUSLOOME_ITEM_ID=
